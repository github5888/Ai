# GraphOne Intelligence Pipeline - copy to .env and fill in what you have.
# Every variable is optional except DATABASE_URL has a sensible default:
# the pipeline degrades gracefully and logs which capabilities are disabled.

# --- Storage ---------------------------------------------------------------
# SQLite by default (zero config). For production scale use PostgreSQL:
#   postgresql+psycopg2://user:password@host:5432/graphone
DATABASE_URL=sqlite:///data/graphone.db

# --- GitHub (paper <-> repo star metrics) ----------------------------------
# Personal access token with `public repo` read scope. Unauthenticated runs
# still work but GitHub caps API traffic at 60 req/hour.
GITHUB_TOKEN=

# --- LLM extraction fallback chain (Phase III) -----------------------------
# Keys are optional: without them the orchestrator logs LLM_UNAVAILABLE and
# uses the deterministic extractor. With them it tries Gemini -> Groq -> DeepSeek.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Primary / fallback model names (defaults shown)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

# --- Google Sheets export (Deliverable 1) ----------------------------------
# Service-account JSON key file, shared on the target spreadsheet with Editor role.
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_ID=

# --- Crawler behaviour (Phase V) -------------------------------------------
USER_AGENT=GraphOneBot/1.0 (+https://github.com/github5888/Ai; research pipeline)
CONCURRENCY=8                 # global in-flight HTTP requests
REQUEST_MIN_INTERVAL=0.25     # polite per-host minimum seconds between requests
FRESHNESS_HOURS=24            # Phase II freshness window

# --- LLM retry / chunking policy (Phase III) -------------------------------
LLM_MAX_ATTEMPTS=5            # attempts per provider before failing over
LLM_BACKOFF_BASE=2.0          # 2s, 4s, 8s, 16s ... exponential backoff
LLM_BACKOFF_MAX_DELAY=60.0
LLM_BACKOFF_JITTER=0.25       # +-25% full jitter
LLM_CHUNK_CHARS=12000         # ~3000 tokens per chunk (413 prevention)
